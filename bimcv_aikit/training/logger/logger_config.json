{
  "version": 1,
  "disable_existing_loggers": true,
  "formatters": {
    "color": {
      "class": "bimcv_aikit.training.logger.logger.ColorFormatter",
      "format": "[%(asctime)s] %(name)s - %(levelname)s: %(message)s"
    },
    "simple": {
      "format": "[%(asctime)s] %(name)s - %(levelname)s: %(message)s"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "color",
      "stream": "ext://sys.stdout"
    },
    "info_file_handler": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "DEBUG",
      "formatter": "simple",
      "filename": "info.log",
      "maxBytes": 10485760,
      "backupCount": 20,
      "encoding": "utf8"
    }
  },
  "root": {
    "level": "DEBUG",
    "handlers": [
      "console",
      "info_file_handler"
    ]
  }
}
